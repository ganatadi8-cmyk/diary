# Copy to .env for local development; never commit real credentials.
# On Vercel, add DATABASE_URL and SECRET_KEY in Project Settings > Environment Variables.
# See docs/deployment.md for the production setup and redeploy steps.
# Local development: persistent SQLite. Production: Neon pooled PostgreSQL URL.
DATABASE_URL=sqlite:///diary.db
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Set production outside Vercel; VERCEL also automatically enables production checks.
APP_ENV=development
# Optional. Only the explicit writing-assistant action sends text to Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
